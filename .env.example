####################################################################
# Pune Civic Portal - environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
####################################################################

# ---------- Core ----------
NODE_ENV=development
APP_NAME="Pune Civic Portal"
APP_URL=https://local-grievance.keasofttech.com/

# ---------- Database (MySQL 8) ----------
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://u909050637_pune_grev_2026:pune_gRev@2026@srv1497.hstgr.io:3306/u909050637_pune_grev"

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
AUTH_SECRET="WkRiQ41aigvTtV6vNblY2gS3wkdZbf6RJjWHNKMte+tDau/U2WtzZgYNrabTesmj"
SESSION_TTL_HOURS=12

# ---------- File storage ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
MAX_UPLOAD_MB=8

# ---------- WhatsApp ----------
# Destination number of the social worker (E.164, no "+"): e.g. 919812345678
SOCIAL_WORKER_WHATSAPP=918378989159
# meta | twilio | console
WHATSAPP_PROVIDER=console

# -- Meta WhatsApp Cloud API --
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0
# Approved template used to open the conversation outside the 24h window.
META_WHATSAPP_TEMPLATE_NAME=civic_complaint_alert
META_WHATSAPP_TEMPLATE_LANG=en
# Token used to verify the inbound webhook subscription.
META_WHATSAPP_VERIFY_TOKEN=
# App secret for validating X-Hub-Signature-256 on inbound webhooks.
META_WHATSAPP_APP_SECRET=

# -- Twilio WhatsApp (alternative provider) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# ---------- Bootstrap admin (used by `npm run seed`) ----------
SEED_ADMIN_EMAIL=admin@punecivic.local
SEED_ADMIN_PASSWORD=ChangeMe@12345
SEED_ADMIN_MOBILE=8378989159
